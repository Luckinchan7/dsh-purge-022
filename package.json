{
  "name": "dsh-purge-022",
  "version": "1.2.15",
  "description": "DeepSeek Harness 破甲：让所有模型都能破甲，不同模型可换不同提示词；默认提示词面向国模「小码酱」。含红队模式、无限制模式、无限制模式·子任务；三套预设。rc2.12 加结构性推脱判定（不依赖措辞）、重试前历史净化与采样回暖、surface 按 aiBase 判定，继续加强破甲。Jailbreak for every model — swap prompts per model. 本版为 0.2.2-rc.3 / rc.1 适配分支（满血）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./redteam/persona": "./lib/redteam/persona.js",
    "./package.json": "./package.json",
    "./nolimit": "./lib/nolimit/index.js",
    "./anchor": "./lib/anchor.js",
    "./boost": "./lib/boost.js",
    "./probe": "./lib/probe.js",
    "./anchors": "./lib/anchors.js",
    "./tuning": "./lib/tuning.js",
    "./refusal-retry": "./lib/refusal-retry.js",
    "./nolimit/child": "./lib/nolimit/child-preset.js",
    "./refusal-patterns": "./lib/refusal-patterns.js"
  },
  "bin": {
    "dsh-purge-022": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "!docs/releases",
    "!docs/preview",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs || node -e \"process.exit(0)\"",
    "verify": "node verify-rc213.mjs && node verify-rc214.mjs && node verify-rc2142.mjs && node verify-rc120.mjs && node verify-migration.mjs && node verify-migration-yaml.mjs",
    "ensure-profile": "node scripts/ensure-profile-bundle.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luckinchan7/dsh-purge-022.git"
  },
  "homepage": "https://github.com/Luckinchan7/dsh-purge-022#readme",
  "bugs": {
    "url": "https://github.com/Luckinchan7/dsh-purge-022/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "registry",
      "tarball": "https://github.com/Luckinchan7/dsh-purge-022/releases/download/v1.2.0/dsh-purge-022-1.2.0.tgz",
      "zip": "https://github.com/Luckinchan7/dsh-purge-022/archive/refs/tags/v1.2.0.zip",
      "git": "git+https://github.com/Luckinchan7/dsh-purge-022.git"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.2-rc.1 <0.2.3-0"
  },
  "dshTarget": "0.2.2-rc.5",
  "dshTargets": [
    "0.2.2-rc.5",
    "0.2.2-rc.3",
    "0.2.2-rc.1",
    "0.2.1-rc.2",
    "0.2.0-rc.2"
  ],
  "author": "巴里啊啊",
  "contributors": [
    "小杨 (original dsh-purge)",
    "555bbbAAA (0.2.2 锚点)"
  ],
  "_compat": {
    "host": "0.2.2-rc.5",
    "base": "1.1.71-rc2.1",
    "anchors": "dsh-purge 1.3.9",
    "chains": [
      "0.2.2-rc.5",
      "0.2.2-rc.3",
      "0.2.2-rc.1"
    ]
  }
}
